# Public browser configuration. Values prefixed with VITE_ are intentionally
# embedded in the client bundle; never put service-role, database, R2, Discord,
# or Turnstile secret keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_R2_PUBLIC_URL=https://media.lukibadgehub.com
VITE_TURNSTILE_SITE_KEY=your-public-turnstile-site-key
